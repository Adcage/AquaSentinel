APP_ENV=dev

# Default: sqlite. Override with mysql when needed.
DATABASE_URL=sqlite:///instance/app.db

# Auto create tables on app startup (recommended for template/dev)
AUTO_CREATE_TABLES=true

# File storage and upload settings
STORAGE_ROOT=instance/storage
MAX_UPLOAD_SIZE_MB=10
TABULAR_ALLOWED_EXTENSIONS=csv,xlsx
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,txt,csv,xlsx
UPLOAD_SCENE_DIRS=default:uploads,avatar:avatars,recognition_image:recognition/images,recognition_video:recognition/videos,recognition_report:recognition/reports
VIDEO_ALLOWED_EXTENSIONS=mp4,avi,mov,mkv
MAX_VIDEO_SIZE_MB=500
MODEL_PATH=model/best.pt
MODEL_LABELS_PATH=model/labels.json
MODEL_CONF_THRESHOLD=0.25
VIDEO_INFER_FRAME_INTERVAL=0.2
ENGINE_DEFAULT_FRAME_INTERVAL=0.2
ENGINE_CALLBACK_INTERVAL_SEC=3
ENGINE_TRACK_IOU_THRESHOLD=0.3
ENGINE_TRACK_MAX_AGE_SEC=1.5
ENGINE_DROWNING_MIN_DURATION_SEC=3
ENGINE_DROWNING_POSTURE_THRESHOLD=0.7
ENGINE_DROWNING_THERMAL_THRESHOLD=0.85
ENGINE_DROWNING_EVENT_COOLDOWN_SEC=15
ENGINE_STREAM_RECONNECT_COOLDOWN_SEC=1
ENGINE_STREAM_OPEN_MAX_RETRIES=5
ENGINE_STREAM_OPEN_RETRY_INTERVAL_SEC=2
MODEL_VERSION=drowning_ext
MODEL_VERSION_PATHS_JSON={"v1":"model/best.pt","drowning_ext":"model/drowning_ext.pt"}
RECOGNITION_USE_FAKE_MODEL=false
CAMERA_MAX_UPLOAD_SIZE_MB=2
CAMERA_TARGET_WIDTH=640
CAMERA_INFER_TIMEOUT_MS=8000

# Engine callback
CALLBACK_URL=
CALLBACK_KEY=
CALLBACK_SECRET=
CALLBACK_RETRY_TIMES=3
CALLBACK_TIMEOUT_SEC=5

# WeChat module (optional, configure when wechat_mini_auth or wechat_pay module enabled)
# WECHAT_APP_ID=your_app_id
# WECHAT_APP_SECRET=your_app_secret
# WECHAT_MCH_ID=your_mch_id
# WECHAT_API_KEY=your_api_key
